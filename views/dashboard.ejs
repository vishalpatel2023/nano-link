<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | NanoLink</title>
    <link rel="stylesheet" href="/index_style.css">

    <style>
        /* ── Dashboard-specific overrides & responsive fixes ── */

        /* Make main content top-aligned for dashboard */
        .main-content.dashboard-main {
            align-items: flex-start;
            padding-top: 40px;
            padding-bottom: 40px;
        }

        /* Page title */
        .dashboard-title {
            text-align: left;
            margin-bottom: 24px;
            font-size: 1.8rem;
        }

        /* Table scroll wrapper for mobile */
        .table-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 8px;
        }

        /* Original URL cell: truncate with tooltip */
        .url-cell {
            max-width: 260px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Vertical center all table cells */
        .analytics-table td,
        .analytics-table th {
            vertical-align: middle;
        }

        /* Actions cell: flex row with gap */
        .actions-cell {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: nowrap;
        }

        /* Empty state card */
        .empty-state {
            text-align: center;
            padding: 48px 24px;
        }
        .empty-state p {
            color: #b0b0b0;
            margin-bottom: 20px;
            font-size: 1rem;
        }

        /* Footer fix */
        .app-footer {
            margin-top: auto;
        }

        /* ── Mobile responsive ── */
        @media (max-width: 768px) {
            .app-header {
                padding: 14px 16px;
                gap: 10px;
            }

            .user-profile {
                gap: 10px;
                flex-wrap: wrap;
            }

            .user-email {
                font-size: 0.85rem;
            }

            .main-content.dashboard-main {
                padding: 20px 12px;
            }

            .dashboard-title {
                font-size: 1.4rem;
                text-align: center;
            }

            /* Stack stat cards vertically on mobile */
            .stats-container {
                flex-direction: column;
                gap: 12px;
            }

            /* Table cells smaller padding on mobile */
            .analytics-table th,
            .analytics-table td {
                padding: 12px 10px;
                font-size: 0.85rem;
            }

            .url-cell {
                max-width: 140px;
            }

            /* Stack action buttons vertically on small screens */
            .actions-cell {
                flex-direction: column;
                gap: 6px;
            }

            .copy-btn, .analytics-btn, .delete-btn {
                width: 100%;
                text-align: center;
                padding: 8px 10px;
                font-size: 0.8rem;
            }

            /* Footer */
            .app-footer {
                padding: 16px 12px;
                font-size: 0.8rem;
            }
        }
    </style>
</head>

<body>

    <header class="app-header">
        <a href="/" class="header-logo" style="text-decoration: none;">NanoLink</a>
        <nav class="header-nav">
            <div class="user-profile">
                <span class="user-email" style="cursor: pointer;">👤 <%= user.email %></span>
                <a href="/logout" class="nav-btn logout-btn">Logout</a>
            </div>
        </nav>
    </header>

    <main class="main-content dashboard-main">
        <div class="dashboard-container">
            <h1 class="dashboard-title">Your Analytics</h1>

            <!-- Stat Cards -->
            <div class="stats-container">
                <div class="stat-card">
                    <h3>Total Links</h3>
                    <p><%= totalLinks %></p>
                </div>

                <div class="stat-card">
                    <h3>Total Clicks</h3>
                    <p><%= totalClicks %></p>
                </div>

                <div class="stat-card">
                    <h3>Most Clicked</h3>
                    <% if (mostClickedUrl) { %>
                        <a href="/<%= mostClickedUrl.shortCode %>" target="_blank" class="most-clicked-link">
                            <%= mostClickedUrl.originalUrl %>
                        </a>
                        <p><%= mostClickedUrl.clicks %> clicks</p>
                    <% } else { %>
                        <p>No links yet</p>
                    <% } %>
                </div>
            </div>

            <!-- Empty State -->
            <% if (urls.length === 0) { %>
                <div class="shortener-card empty-state">
                    <p>You haven't shortened any links yet!</p>
                    <a href="/" class="btn-submit" style="text-decoration: none; display: inline-block;">
                        Create your first link ⚡
                    </a>
                </div>
            <% } else { %>

                <!-- Links Table -->
                <div class="table-wrapper">
                    <div class="table-scroll">
                        <table class="analytics-table">
                            <thead>
                                <tr>
                                    <th>Original URL</th>
                                    <th>Short Link</th>
                                    <th>Clicks</th>
                                    <th>Date Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% urls.forEach(function(url) { %>
                                    <tr>
                                        <td class="url-cell" title="<%= url.originalUrl %>">
                                            <a href="<%= url.originalUrl %>" target="_blank" class="table-link">
                                                <%= url.originalUrl %>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="<%= domain %>/<%= url.shortCode %>" target="_blank"
                                               class="table-link short-text">
                                                <%= domain %>/<%= url.shortCode %>
                                            </a>
                                        </td>
                                        <td>
                                            <span class="clicks-badge"><%= url.clicks %></span>
                                        </td>
                                        <td style="color: #b0b0b0; font-size: 0.9rem;">
                                            <%= url.createdAt.toLocaleDateString() %>
                                        </td>
                                        <td class="actions-cell">
                                            <button type="button" class="copy-btn"
                                                onclick="copyShortLink('<%= url.shortCode %>', this)">
                                                Copy
                                            </button>
                                            <a href="/analytics/<%= url._id %>" class="analytics-btn">
                                                Analytics
                                            </a>
                                            <form action="/delete/<%= url._id %>" method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this URL? This action cannot be undone.');">
                                                <button type="submit" class="delete-btn">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

            <% } %>
        </div>
    </main>

    <footer class="app-footer">
        <p>&copy; 2024 NanoLink. All rights reserved.</p>
        <br>
        <p>Developed By Vishal😆</p>
    </footer>

    <script>
        function copyShortLink(shortCode, button) {
            var shortUrl = window.location.origin + "/" + shortCode;

            navigator.clipboard.writeText(shortUrl)
                .then(function () {
                    button.textContent = "Copied!";
                    setTimeout(function () {
                        button.textContent = "Copy";
                    }, 1500);
                })
                .catch(function (error) {
                    console.error("Copy failed:", error);
                });
        }
    </script>

</body>

</html>