<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - NanoLink</title>
    <link rel="stylesheet" href="/login_style.css">

    <style>
        .error-message {
            color: #ff4d4f;
            font-size: 0.85rem;
            margin: -18px 0 12px 0;
            padding: 0;
            display: block;
        }

        .error-message.hidden {
            display: none;
        }

        .error-banner {
            color: #ff4d4f;
            font-size: 0.9rem;
            margin-bottom: 16px;
            padding: 10px 14px;
            background-color: rgba(255, 77, 79, 0.1);
            border: 1px solid rgba(255, 77, 79, 0.3);
            border-radius: 6px;
        }
    </style>
</head>

<body>
    <header class="auth-header">
        <a href="/" class="auth-logo">NanoLink</a>

        <div class="auth-nav">
            <span>Don't have an account?</span>
            <a href="/register" class="auth-nav-btn">Sign Up</a>
        </div>
    </header>

    <div>
        <h2>Login</h2>

        <!-- Backend login error ("Invalid email or password.") -->
        <% if (typeof error !== 'undefined' && error) { %>
            <p class="error-banner">* <%= error %></p>
        <% } %>

        <form id="loginForm" action="/login" method="post">
            <div>
                <label for="username">Email:</label>
                <input type="text" id="username" name="email" required>
                <p id="emailError" class="error-message hidden">
                    Please enter your email.
                </p>
            </div>

            <div>
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>
                <p id="passwordError" class="error-message hidden">
                    Please enter your password.
                </p>
            </div>

            <div>
                <button type="submit">Sign In</button>
            </div>

        </form>
        <p class="signup-link">
            Don't have an account?
            <a href="/register">Sign up here</a>
        </p>
    </div>

    <script>
        var emailInput = document.getElementById('username');
        var passwordInput = document.getElementById('password');
        var emailError = document.getElementById('emailError');
        var passwordError = document.getElementById('passwordError');
        var form = document.getElementById('loginForm');

        form.addEventListener('submit', function (e) {
            var emailValue = emailInput.value.trim();
            var passwordValue = passwordInput.value.trim();
            var hasError = false;

            // Check email
            if (emailValue.length === 0) {
                e.preventDefault();
                emailError.classList.remove('hidden');
                hasError = true;
            } else {
                emailError.classList.add('hidden');
            }

            // Check password
            if (passwordValue.length === 0) {
                e.preventDefault();
                passwordError.classList.remove('hidden');
                hasError = true;
            } else {
                passwordError.classList.add('hidden');
            }

            // Focus the first empty field
            if (hasError) {
                if (emailValue.length === 0) {
                    emailInput.focus();
                } else {
                    passwordInput.focus();
                }
            }
        });

        // --- Hide warnings as user starts typing ---
        emailInput.addEventListener('input', function () {
            if (emailInput.value.trim().length > 0) {
                emailError.classList.add('hidden');
            }
        });

        passwordInput.addEventListener('input', function () {
            if (passwordInput.value.trim().length > 0) {
                passwordError.classList.add('hidden');
            }
        });
    </script>
</body>
</html>